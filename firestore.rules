rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if true;
    }
    match /audio_recordings/{audioId} {
      allow read: if true;
      allow write: if true;
    }
    match /audio_recordings/{audioId}/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
